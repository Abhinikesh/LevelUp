{
  "name": "stepup",
  "scripts": {
    "server": "cd stepup-server && npm run dev",
    "client": "cd stepup-client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install-all": "cd stepup-server && npm install && cd ../stepup-client && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
